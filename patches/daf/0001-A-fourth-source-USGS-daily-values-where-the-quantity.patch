+"""The USGS daily-values source: adapter, extractor, and end-to-end admission.
+
+One recorded REAL response is used as the fixture
+(`tests/fixtures/usgs_daily_values_09147000_20230101_20230105.json`: Dallas Creek near
+Ridgway, CO, discharge, daily mean, 2023-01-01..2023-01-05, recorded verbatim from
+api.waterdata.usgs.gov). It is real on purpose -- it is the only way to test against
+what the API actually does: items in no time order, `value` as a string, `qualifier`
+sometimes `["ESTIMATED"]` and sometimes `null`, and no uncertainty stated anywhere.
+Everything a real response cannot exhibit (a `next` link, a malformed feature, an
+unknown parameter code) is built here as an edited copy and said to be one.
+
+No test in this file makes a network request.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any, Dict
+
+import pytest
+
+from daf.adapters.usgs_daily_values import (
+    DAILY_ITEMS_BASE,
+    MAX_WINDOW_DAYS,
+    PAGE_LIMIT,
+    UsgsDailyValuesFetchError,
+    UsgsDailyValuesSourceAdapter,
+    window_end_of,
+)
+from daf.catalog.checkpoint import CheckpointStore
+from daf.catalog.plan import AcquisitionPlan
+from daf.extractors.usgs_daily_values import (
+    EXTRACTION_METHOD,
+    PARAMETER_PROPERTIES,
+    UsgsDailyValuesExtractionError,
+    UsgsDailyValuesExtractor,
+)
+from daf.orchestration.adapter_registry import AdapterRegistry
+from daf.orchestration.bindings import _advance_usgs_daily_values_position, usgs_daily_values_binding
+from daf.orchestration.result import AcquiredArtifact, AcquisitionOutcome
+from daf.orchestration.source_registry import SourceDefinition, SourceRegistry
+from daf.scheduling.runner import execute_plan
+from daf.storage.durable_pool import DurablePool
+from daf.storage.filesystem_store import FilesystemEvidenceStore
+from evidence.types import Record
+
+FIXTURES = Path(__file__).parent / "fixtures"
+FIXTURE = FIXTURES / "usgs_daily_values_09147000_20230101_20230105.json"
+SITE = "USGS-09147000"
+PARAM = "00060"
+STAT = "00003"
+RETRIEVED_AT = "2026-09-12T00:00:00Z"
+SOURCE_ID = "usgs-daily-values"
+
+PARAMS = {"monitoring_location_id": SITE, "parameter_code": PARAM, "statistic_id": STAT,
+          "start_date": "2023-01-01", "end_date": "2023-01-05"}
+
+
+def _raw() -> bytes:
+    return FIXTURE.read_bytes()
+
+
+def _record(content: str | None = None) -> Record:
+    from evidence.types import make_document, make_record, make_source
+
+    body = content if content is not None else _raw().decode("utf-8")
+    source = make_source(name="USGS Water Data OGC API -- daily values", kind="daily-value-window")
+    document = make_document(source_id=source.id, raw_content=body,
+                             retrieval_method="http:usgs_daily_values_v1", retrieved_at=RETRIEVED_AT)
+    return make_record(document_id=document.id, locator=f"{SITE}:{PARAM}:{STAT}:2023-01-01:2023-01-05",
+                       raw_content=body)
+
+
+def _adapter(**kw: Any) -> UsgsDailyValuesSourceAdapter:
+    args: Dict[str, Any] = dict(
+        monitoring_location_id=SITE, parameter_code=PARAM, statistic_id=STAT,
+        start_date="2023-01-01", end_date="2023-01-05", retrieved_at=RETRIEVED_AT,
+        fetch_bytes=lambda url: _raw(),
+    )
+    args.update(kw)
+    return UsgsDailyValuesSourceAdapter(**args)
+
+
+# ---------------------------------------------------------------------------
+# the adapter
+# ---------------------------------------------------------------------------
+
+def test_the_request_names_every_dimension_of_the_series_and_the_page_bound():
+    seen = []
+    documents = _adapter(fetch_bytes=lambda url: (seen.append(url), _raw())[1]).fetch()
+    assert len(seen) == 1 and seen[0].startswith(DAILY_ITEMS_BASE + "?")
+    for fragment in (f"monitoring_location_id={SITE}", f"parameter_code={PARAM}",
+                     f"statistic_id={STAT}", "datetime=2023-01-01%2F2023-01-05",
+                     f"limit={PAGE_LIMIT}", "f=json"):
+        assert fragment in seen[0], seen[0]
+    assert len(documents) == 1
+    doc = documents[0]
+    assert doc.locator == f"{SITE}:{PARAM}:{STAT}:2023-01-01:2023-01-05"
+    assert window_end_of(doc.locator) == "2023-01-05"
+    assert doc.retrieval_method == "http:usgs_daily_values_v1"
+    assert doc.retrieved_at == RETRIEVED_AT
+    assert doc.content.encode("utf-8") == _raw()       # byte-for-byte, nothing reinterpreted
+
+
+def test_a_paged_window_is_refused_not_stitched():
+    """Stitching pages would fabricate bytes no server sent; dropping the tail would lose
+    data. An edited copy of the real fixture, with a next link added."""
+    payload = json.loads(_raw())
+    payload["links"].append({"rel": "next", "href": "https://example.invalid/next", "type": "application/geo+json"})
+    paged = json.dumps(payload).encode("utf-8")
+    with pytest.raises(UsgsDailyValuesFetchError, match="more than one page"):
+        _adapter(fetch_bytes=lambda url: paged).fetch()
+
+
+def test_the_window_is_bounded_so_one_window_stays_one_page():
+    with pytest.raises(UsgsDailyValuesFetchError, match="window_days"):
+        _adapter(window_days=MAX_WINDOW_DAYS + 1)
+    with pytest.raises(UsgsDailyValuesFetchError, match="window_days"):
+        _adapter(window_days=0)
+    with pytest.raises(UsgsDailyValuesFetchError, match="revision_lookback_days"):
+        _adapter(revision_lookback_days=0)
+
+
+def test_the_trailing_safety_window_re_requests_revisable_days_and_the_scope_terminates():
+    seen = []
+
+    def spy(url: str) -> bytes:
+        seen.append(url)
+        return _raw()
+
+    # a 3-day window with a 2-day lookback, over a 10-day scope
+    a = _adapter(end_date="2023-01-10", window_days=3, revision_lookback_days=2, fetch_bytes=spy)
+    a.fetch()
+    assert "datetime=2023-01-01%2F2023-01-03" in seen[-1]
+    # the next call starts one day before the previous end: the revisable tail is re-read
+    a2 = _adapter(end_date="2023-01-10", window_days=3, revision_lookback_days=2,
+                  since_window_end="2023-01-03", fetch_bytes=spy)
+    a2.fetch()
+    assert "datetime=2023-01-02%2F2023-01-04" in seen[-1]
+    # past the scope end, nothing is requested at all
+    before = len(seen)
+    assert _adapter(end_date="2023-01-10", since_window_end="2023-01-12", fetch_bytes=spy).fetch() == ()
+    assert len(seen) == before
+
+
+def test_the_cursor_never_rewinds():
+    art = AcquiredArtifact(artifact_id="a", version_id="v", is_new=True,
+                           locator=f"{SITE}:{PARAM}:{STAT}:2023-01-02:2023-01-04", raw_content=None)
+    assert _advance_usgs_daily_values_position((art,), None) == "2023-01-04"
+    assert _advance_usgs_daily_values_position((art,), "2023-01-09") == "2023-01-09"
+    assert _advance_usgs_daily_values_position((), "2023-01-09") == "2023-01-09"
+
+
+def test_an_unusable_body_is_an_acquisition_failure_not_a_silent_empty():
+    for body, match in ((b"{", "valid JSON"), (b'{"type":"FeatureCollection"}', "features"),
+                        (b"\xff\xfe", "UTF-8")):
+        with pytest.raises(UsgsDailyValuesFetchError, match=match):
+            _adapter(fetch_bytes=lambda url, b=body: b).fetch()
+
+
+# ---------------------------------------------------------------------------
+# the extractor
+# ---------------------------------------------------------------------------
+
+def test_every_content_field_is_read_from_the_response():
+    candidates = UsgsDailyValuesExtractor().extract(_record())
+    assert len(candidates) == 5
+    assert {c.extraction_method for c in candidates} == {EXTRACTION_METHOD}
+    by_day = {c.content["measurement_time"]: c.content for c in candidates}
+    assert sorted(by_day) == ["2023-01-01", "2023-01-02", "2023-01-03", "2023-01-04", "2023-01-05"]
+    c = by_day["2023-01-02"]
+    assert c["property"] == PARAMETER_PROPERTIES[PARAM] == "discharge"
+    assert c["value"] == 19.7 and isinstance(c["value"], float)     # the API sends "19.7", a string
+    assert c["unit"] == "ft^3/s"                                    # verbatim, not a requested default
+    assert c["method"] == STAT                                      # the statistic: which number this is
+    assert c["monitoring_location_id"] == SITE and c["parameter_code"] == PARAM
+    # No conditions: section 20 lets an extractor CARRY them and not CONSTRUCT them, and this
+    # source states none. `method` already separates a daily mean from a daily maximum, so
+    # nothing is lost by refusing to invent one. daf's own
+    # test_no_extractor_declares_a_conditions_key is the guard that caught the first draft.
+    assert "conditions" not in c
+
+
+def test_revision_metadata_and_a_fabricated_uncertainty_stay_out_of_content():
+    """approval_status and qualifier say how far a value moved through review, not what was
+    measured -- exactly as NOAA's q flag does. And the response states no uncertainty, so
+    none is emitted: science.admissibility's MISSING_UNCERTAINTY_KIND is the true report."""
+    raw = json.loads(_raw())
+    assert {f["properties"]["approval_status"] for f in raw["features"]} == {"Approved"}
+    assert ["ESTIMATED"] in [f["properties"]["qualifier"] for f in raw["features"]]
+    for c in UsgsDailyValuesExtractor().extract(_record()):
+        assert not ({"approval_status", "qualifier", "last_modified", "id"} & set(c.content))
+        assert not ({"uncertainty", "uncertainty_kind", "sigma"} & set(c.content))
+
+
+def test_a_value_that_only_changes_status_keeps_its_content():
+    """The identity consequence of the rule above, stated as a test: Provisional -> Approved
+    with the same number is the same evidence and must hash the same."""
+    raw = json.loads(_raw())
+    for f in raw["features"]:
+        f["properties"]["approval_status"] = "Provisional"
+        f["properties"]["qualifier"] = None
+        f["properties"]["last_modified"] = "2019-01-01T00:00:00+00:00"
+    provisional = UsgsDailyValuesExtractor().extract(_record(json.dumps(raw)))
+    approved = UsgsDailyValuesExtractor().extract(_record())
+    assert [dict(c.content) for c in provisional] == [dict(c.content) for c in approved]
+
+
+def test_an_unknown_parameter_code_is_refused_never_named_by_a_rule():
+    raw = json.loads(_raw())
+    for f in raw["features"]:
+        f["properties"]["parameter_code"] = "72019"        # a real USGS code this table does not carry
+    with pytest.raises(UsgsDailyValuesExtractionError, match="no property name for"):
+        UsgsDailyValuesExtractor().extract(_record(json.dumps(raw)))
+
+
+def test_a_missing_or_unparseable_field_raises_rather_than_dropping_a_day():
+    for mutate, match in (
+        (lambda p: p.update(value="not a number"), "non-numeric"),
+        (lambda p: p.update(value=None), "missing"),
+        (lambda p: p.update(unit_of_measure=""), "missing"),
+        (lambda p: p.update(time=None), "missing"),
+    ):
+        raw = json.loads(_raw())
+        mutate(raw["features"][0]["properties"])
+        with pytest.raises(UsgsDailyValuesExtractionError, match=match):
+            UsgsDailyValuesExtractor().extract(_record(json.dumps(raw)))
+    raw = json.loads(_raw())
+    raw["features"][0] = {"type": "Feature"}
+    with pytest.raises(UsgsDailyValuesExtractionError, match="no 'properties'"):
+        UsgsDailyValuesExtractor().extract(_record(json.dumps(raw)))
+
+
+def test_the_source_order_is_preserved_and_never_sorted_here():
+    """Items arrive in no time order. The extractor emits them as the response carries them;
+    ordering is the consumer's declared choice, not a silent one made here."""
+    raw = json.loads(_raw())
+    order = [f["properties"]["time"] for f in raw["features"]]
+    assert order != sorted(order), "the recorded response is unordered -- that is the point of this test"
+    assert [c.content["measurement_time"] for c in UsgsDailyValuesExtractor().extract(_record())] == order
+
+
+# ---------------------------------------------------------------------------
+# end to end
+# ---------------------------------------------------------------------------
+
+def _registries(fetch_bytes):
+    binding = usgs_daily_values_binding(fetch_bytes=fetch_bytes)
+    sources = SourceRegistry()
+    sources.register(SourceDefinition(
+        source_id=SOURCE_ID, name="USGS Water Data OGC API", domain="environmental-observations",
+        adapter_id=binding.adapter_id,
+        required_parameters=("monitoring_location_id", "parameter_code", "statistic_id",
+                             "start_date", "end_date"),
+        capabilities=("incremental",)))
+    adapters = AdapterRegistry()
+    adapters.register(binding)
+    return sources, adapters
+
+
+def test_the_same_window_is_a_duplicate_and_an_overlapping_one_re_admits_under_a_new_record(tmp_path):
+    """Measured, not assumed. The FIRST call acquires 2023-01-01..05. The SECOND starts from
+    the checkpoint and so requests 2023-01-04..05 -- the trailing safety window -- which is a
+    DIFFERENT locator, hence a different Record, hence different Observation ids for the very
+    same readings. The THIRD call requests that same window again and admits nothing.
+
+    So DAF deduplicates an identical ARTIFACT, and does not pretend that the same reading seen
+    through two windows is one observation -- it cannot, because the record it came from is
+    part of what an observation is. Collapsing those is the consumer's job, on content, which
+    is what set_lcm.bridge.daf does downstream."""
+    sources, adapters = _registries(lambda url: _raw())
+    pool = DurablePool(FilesystemEvidenceStore(tmp_path / "evidence"))
+    checkpoints = CheckpointStore(tmp_path / "checkpoints")
+    plan = AcquisitionPlan(plan_id="p", source_id=SOURCE_ID, parameters=PARAMS, mode="incremental")
+
+    first = execute_plan(plan, sources, adapters, pool, checkpoints, requested_at=RETRIEVED_AT)
+    assert first.outcome is AcquisitionOutcome.ACQUIRED
+    observations = pool.all_observations()
+    assert len(observations) == 5 and len({o.id for o in observations}) == 5
+    assert {o.extraction_method for o in observations} == {EXTRACTION_METHOD}
+    assert {o.content["property"] for o in observations} == {"discharge"}
+    assert len({o.record_ids for o in observations}) == 1
+
+    second = execute_plan(plan, sources, adapters, pool, checkpoints, requested_at=RETRIEVED_AT)
+    assert second.outcome is AcquisitionOutcome.DUPLICATE      # the artifact version already existed
+    after_second = pool.all_observations()
+    assert len(after_second) == 10 and len({o.id for o in after_second}) == 10
+    assert len({o.record_ids for o in after_second}) == 2      # two windows, two records
+    # ...and the readings themselves are the same five days twice, identical in content
+    by_day: Dict[str, set] = {}
+    for o in after_second:
+        by_day.setdefault(o.content["measurement_time"], set()).add(o.content["value"])
+    assert sorted(by_day) == ["2023-01-01", "2023-01-02", "2023-01-03", "2023-01-04", "2023-01-05"]
+    assert all(len(values) == 1 for values in by_day.values())
+
+    third = execute_plan(plan, sources, adapters, pool, checkpoints, requested_at=RETRIEVED_AT)
+    assert third.outcome is AcquisitionOutcome.DUPLICATE
+    assert len(pool.all_observations()) == 10                  # the cursor has settled: nothing new
+
+
+def test_a_revised_value_is_new_evidence_and_the_old_one_is_not_overwritten(tmp_path):
+    """A window re-fetched after USGS changes a number: the changed day admits a NEW
+    observation and the original stays in the pool. A revision is not a state transition."""
+    bodies = [_raw()]
+    revised = json.loads(_raw())
+    revised["features"][0]["properties"]["value"] = "19.9"     # 2023-01-02: 19.7 -> 19.9
+    bodies.append(json.dumps(revised).encode("utf-8"))
+    calls = {"n": 0}
+
+    def serve(url: str) -> bytes:
+        body = bodies[min(calls["n"], len(bodies) - 1)]
+        calls["n"] += 1
+        return body
+
+    sources, adapters = _registries(serve)
+    pool = DurablePool(FilesystemEvidenceStore(tmp_path / "evidence"))
+    checkpoints = CheckpointStore(tmp_path / "checkpoints")
+    plan = AcquisitionPlan(plan_id="p", source_id=SOURCE_ID, parameters=PARAMS, mode="incremental")
+
+    execute_plan(plan, sources, adapters, pool, checkpoints, requested_at=RETRIEVED_AT)
+    execute_plan(plan, sources, adapters, pool, checkpoints, requested_at=RETRIEVED_AT)
+    for_day = [o for o in pool.all_observations() if o.content["measurement_time"] == "2023-01-02"]
+    assert sorted(o.content["value"] for o in for_day) == [19.7, 19.9]
+    assert len({o.id for o in for_day}) == 2
+
+
+def test_the_binding_needs_no_scientific_parameters_of_its_own():
+    """Unlike NOAA's, whose response echoes neither datum nor unit: USGS states every
+    dimension in the item, so there is nothing for a binding to keep in step."""
+    import inspect
+
+    signature = inspect.signature(usgs_daily_values_binding)
+    assert list(signature.parameters) == ["fetch_bytes"]
+    assert UsgsDailyValuesExtractor() == UsgsDailyValuesExtractor()   # no state to configure

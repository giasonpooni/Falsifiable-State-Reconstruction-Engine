@@ -341,3 +344,78 @@ def noaa_water_level_measurement_binding(
         advance_position=_advance_noaa_position,
         version=_code_version(NoaaWaterLevelSourceAdapter, NoaaWaterLevelMeasurementExtractor),
     )
+
+
+def _advance_usgs_daily_values_position(
+    artifacts: Tuple[AcquiredArtifact, ...], previous_position: Optional[str]
+) -> Optional[str]:
+    """The daily-values window locator
+    (`"{monitoring_location_id}:{parameter_code}:{statistic_id}:{begin}:{end}"`)
+    carries its own cursor value -- the window's end date -- exactly like
+    NOAA's window locator and EDGAR's date-string locators, and UNLIKE
+    USGS's event-id locator. Reading `.locator`, not `.raw_content`, for
+    the same reason NOAA does.
+
+    The cursor never goes backwards: a trailing-safety re-fetch of an
+    earlier window must not rewind the position and re-acquire the scope.
+    """
+    if not artifacts:
+        return previous_position
+    max_end = max(daily_window_end_of(artifact.locator) for artifact in artifacts)
+    if previous_position is not None:
+        max_end = max(max_end, previous_position)
+    return max_end
+
+
+def usgs_daily_values_binding(*, fetch_bytes: Optional[Fetcher] = None) -> AdapterBinding:
+    """`UsgsDailyValuesSourceAdapter` paired with the per-value
+    `UsgsDailyValuesExtractor`.
+
+    This binding takes NO scientific parameters, and that is the point of
+    difference from `noaa_water_level_measurement_binding`. NOAA's
+    response echoes neither datum nor unit, so the binding must hand the
+    same values to adapter and extractor or the two can silently
+    disagree. USGS states `unit_of_measure`, `parameter_code` and
+    `statistic_id` in every item, so the extractor reads what the adapter
+    requested from the response itself and there is nothing to keep in
+    step. `monitoring_location_id`, `parameter_code` and `statistic_id`
+    are plan parameters: they select the series, and the response carries
+    them back.
+
+    `fetch_bytes` is the adapter's own injection point, surfaced here so a
+    caller can replay a recorded response instead of hitting the live
+    service; omitted, the adapter's live HTTP default is used unchanged.
+    """
+
+    def build_adapter(source: SourceDefinition, request: AcquisitionRequest) -> UsgsDailyValuesSourceAdapter:
+        since = request.parameters.get("since")
+        window_days = request.parameters.get("window_days")
+        # Written out twice rather than assembled as **kwargs so mypy actually checks
+        # the call: the adapter's `fetch_bytes` default is its live HTTP fetcher, which
+        # must stay in place when none is injected -- passing None would disable
+        # acquisition entirely. Same idiom as the NOAA binding.
+        common = {
+            "monitoring_location_id": str(request.parameters["monitoring_location_id"]),
+            "parameter_code": str(request.parameters["parameter_code"]),
+            "statistic_id": str(request.parameters["statistic_id"]),
+            "start_date": str(request.parameters["start_date"]),
+            "end_date": str(request.parameters["end_date"]),
+            "retrieved_at": request.requested_at,
+            "since_window_end": str(since) if since is not None else None,
+        }
+        if window_days is not None:
+            common["window_days"] = int(window_days)
+        if fetch_bytes is None:
+            return UsgsDailyValuesSourceAdapter(**common)  # type: ignore[arg-type]
+        return UsgsDailyValuesSourceAdapter(fetch_bytes=fetch_bytes, **common)  # type: ignore[arg-type]
+
+    def build_extractor() -> UsgsDailyValuesExtractor:
+        return UsgsDailyValuesExtractor()
+
+    return AdapterBinding(
+        adapter_id="usgs-daily-values",
+        build_adapter=build_adapter,
+        build_extractor=build_extractor,
+        advance_position=_advance_usgs_daily_values_position,
+        version=_code_version(UsgsDailyValuesSourceAdapter, UsgsDailyValuesExtractor),
+    )
diff --git a/docs/PHASE_45_USGS_DAILY_VALUES.md b/docs/PHASE_45_USGS_DAILY_VALUES.md
new file mode 100644
index 0000000..a5042da
--- /dev/null
+++ b/docs/PHASE_45_USGS_DAILY_VALUES.md
@@ -0,0 +1,157 @@
+# Phase 45 — USGS Daily Values: a statistic is not a measurement
+
+*(Continues from Phase 44. Adds a fourth real source: the USGS Water Data OGC API's
+`daily` collection. Asks what changes when the acquired quantity is a DAILY STATISTIC
+computed by the source rather than an instrument reading, and when the source states a
+date with no time zone.)*
+
+**Result: accepted, with two refusals that are the point of the phase.** The source is
+admissible exactly as the existing contract stands — no new field, no new gate, no change
+to any core type. What it forced was two explicit refusals: the adapter refuses a paged
+window instead of stitching one, and neither adapter nor extractor assigns the source's
+bare date a time zone. Both are recorded here so a later reader does not "fix" them.
+
+---
+
+## Reconnaissance
+
+Read in full before writing anything: `daf/adapters/noaa_water_level.py` (the closest
+topology), `daf/adapters/usgs_earthquakes.py` (the retry and user-agent policy, reused
+verbatim), `daf/extractors/noaa_water_level_measurements.py` (the per-measurement
+extractor shape), `daf/extractors/usgs_earthquakes.py` (Phase 31's `method` convention),
+`daf/orchestration/bindings.py`, `daf/scheduling/runner.py`, `science/admissibility.py`'s
+code, and the live endpoint itself.
+
+The live endpoint was read before the module was written, not after:
+
+| what | measured |
+|---|---|
+| item order | **none**. `2023-01-02, 2023-01-05, 2023-01-03, 2023-01-04, 2023-01-01` came back in that order |
+| `value` | a **string**: `"19.7"` |
+| paging | opaque cursor in `links[rel="next"]`; `limit` up to 10000 |
+| `time` | a **bare date**, `"2023-01-07"`, with no zone anywhere in the response |
+| revision | `approval_status` (`Provisional` → `Approved`), `qualifier` (`null` or e.g. `["ESTIMATED"]`), `last_modified` |
+| uncertainty | **none stated, anywhere** |
+
+## The fourth topology
+
+| | EDGAR (G) | USGS events (H) | NOAA (I) | **USGS daily (45)** |
+|---|---|---|---|---|
+| unit | one index FILE | one event RECORD | one bounded WINDOW of unidentified readings | one bounded WINDOW of ONE SERIES |
+| per-item identity | none | the event id, stable | none | an `id` exists, but it is a **row id regenerated on revision** — so it is *not* usable as identity |
+| locator is the cursor | yes | no | yes | yes |
+| revision | never | per record | per window's bytes | per value: status flips, and the number can change with it |
+
+The row-id column is the new thing. USGS events gave each event a stable id, which is why
+its locator could not be the cursor. Daily values give each *row* an id too — but it is
+regenerated when the value is revised, so using it as identity would make every review
+step look like a new fact. It is therefore not carried into content at all, and identity
+stays where it already was: the content hash.
+
+## Refusal 1 — a paged window is refused, never stitched
+
+`RawDocument.content` is one HTTP response, byte for byte, in every adapter this
+repository has. A cursor-paged collection has no single response for a window, so there
+were three options:
+
+1. **Stitch the pages** into one synthetic document. Rejected: it fabricates bytes no
+   server ever sent, and the artifact would no longer be the thing that was retrieved.
+2. **One `RawDocument` per page.** Rejected: page boundaries are an artifact of `limit`
+   and of server-side cursor state, so the same window could acquire under different
+   locators on different days, and identity would depend on paging.
+3. **Bound the window so it is always one page, and raise if it ever is not.** Taken.
+
+A daily series is at most 366 items a year against a `limit` of 10000, so
+`MAX_WINDOW_DAYS = 366` makes the single-response property a consequence of a declared
+bound rather than of luck. If a `next` link appears anyway, `fetch()` raises and the
+message says to shorten `window_days`. The adapter does not quietly return the first page:
+a silent truncation here would be a lost day of water, and nothing downstream could tell.
+
+## Refusal 2 — the date keeps its silence
+
+`properties.time` is `"2023-01-07"`. The API's own description defines it only as the
+date an observation represents. It states no zone.
+
+Legacy NWIS practice is the site's local standard time, and it would have been easy to
+write `measurement_time` as `2023-01-07T00:00:00-07:00`, or to call it a UTC day. Both
+were rejected. DAF records what a source said; a zone this source did not state is an
+assumption, and an assumption recorded as data is indistinguishable from a fact one line
+later. `measurement_time` is therefore the bare date, verbatim, and what a day means is a
+declaration for whoever consumes it — made explicitly, with a citation, at that boundary.
+
+This is the same discipline as Phase 32's uncertainty rule, applied to time.
+
+## `method`, and why a statistic needs one
+
+Phase 31 established that `method` carries the source's own verbatim token for HOW a
+number was computed (`magnitude_type`: `"mb"`, `"ml"`). Daily values make that field load-
+bearing rather than decorative: a daily MEAN discharge (`statistic_id` `00003`), a daily
+MAXIMUM (`00001`) and a daily MINIMUM (`00002`) are three different quantities at the same
+site, on the same day, in the same unit. Without `method` they are indistinguishable in
+content, and two of them would hash to the same observation whenever their values coincide.
+
+`method` is the verbatim `statistic_id`, and `statistic_id` is also in `conditions`
+alongside `parameter_code`, as a `FrozenMapping` (Phase 34: `conditions` must be hashable
+to reach `materials.analysis`). `"00003"` is not translated to `"mean"` here — the source
+token is what the source wrote, exactly as `"mb"` is not translated to `"body-wave"`.
+
+## What the binding does NOT have to do
+
+`noaa_water_level_measurement_binding` exists in the shape it does because NOAA's response
+echoes neither the datum nor the unit: the binding must hand the same `datum`/`units` to
+adapter and extractor, or the two can silently disagree and every value gets labelled with
+a datum it was not measured against.
+
+USGS states `unit_of_measure`, `parameter_code` and `statistic_id` in **every item**. So
+`UsgsDailyValuesExtractor` takes no constructor parameters at all, and
+`usgs_daily_values_binding` takes only `fetch_bytes`. Everything the extractor writes, it
+read. There is nothing to keep in step, so there is no way for it to drift — a property
+worth naming, because it is the absence of a whole class of bug that NOAA's shape must
+actively prevent. `test_the_binding_needs_no_scientific_parameters_of_its_own` pins it.
+
+## The property table is a table, not a rule
+
+`PARAMETER_PROPERTIES` maps `00060 → discharge`, `00054 → reservoir_storage`,
+`00065 → gage_height`. An unlisted code **raises**. It would have been one line to
+generate `f"parameter_{code}"` and accept everything; that line would put a label into
+evidence that no source ever used, for a quantity nobody had looked up. Adding a code is a
+deliberate act with the USGS parameter definition in front of you.
+
+## A revision that changes nothing must change nothing
+
+`approval_status`, `qualifier`, `last_modified` and the row `id` are all kept out of
+`content`, for the reason NOAA's `q` flag is: they describe how far a value has moved
+through review, not what was measured. The consequence is stated as a test
+(`test_a_value_that_only_changes_status_keeps_its_content`): a value that goes
+Provisional → Approved **without changing** produces byte-identical content and therefore
+the same observation id. A value that changes IS new evidence, and its content changes on
+its own — `test_a_revised_value_is_new_evidence_and_the_old_one_is_not_overwritten` shows
+both versions living in the pool, neither overwriting the other.
+
+## What acquisition measured about itself
+
+`test_the_same_window_is_a_duplicate_and_an_overlapping_one_re_admits_under_a_new_record`
+records a behaviour that was measured rather than assumed, and that a consumer needs to
+know:
+
+- Re-running a settled plan re-requests the **same** window, gets the same bytes, and
+  admits nothing: `DUPLICATE`.
+- But the *first* incremental step after a fresh acquisition requests the **trailing
+  safety window** — a different locator, hence a different `Record`, hence *different
+  observation ids for the very same readings*.
+
+DAF is right not to collapse those: the record an observation came from is part of what
+the observation is. Collapsing them is the consumer's job, done on **content**, and a
+consumer that does it must compare whole contents rather than a chosen subset. That is
+what `set_lcm.bridge.daf` does, and it is why it refuses to merge two observations whose
+contents differ in any field at all.
+
+## Not done here
+
+- **No uncertainty.** USGS publishes rating-curve accuracy qualitatively, per site and per
+  period, in documents this endpoint does not carry. Nothing numeric can honestly be
+  emitted, so nothing is. `science.admissibility` reports `MISSING_UNCERTAINTY_KIND` for
+  every one of these values, and that report is true.
+- **No instantaneous-values collection.** The `daily` collection only.
+- **No site-metadata acquisition.** Drainage areas, datums and lake areas live in other
+  collections; nothing here reads them.

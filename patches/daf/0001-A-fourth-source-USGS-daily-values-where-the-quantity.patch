index 0000000..df36a9d
--- /dev/null
+++ b/daf/extractors/usgs_daily_values.py
@@ -0,0 +1,184 @@
+"""Per-value extractor for the USGS Water Data OGC API's `daily` collection.
+
+One `ExtractionCandidate` per feature: one day, one series, one number. Paired with
+`UsgsDailyValuesSourceAdapter` by `usgs_daily_values_binding`.
+
+WHAT IS IN `content`, AND WHY EACH FIELD IS WHAT IT IS
+------------------------------------------------------
+
+`property`   A declared name for the physical quantity, looked up from the USGS parameter
+             code in `PARAMETER_PROPERTIES`. An UNLISTED CODE IS REFUSED, never given a
+             generated name: inventing "parameter_72019" would put a label into evidence
+             that no source ever used. Adding a code to the table is a deliberate act with
+             the USGS parameter-code definition in front of you.
+
+`value`      `float(properties.value)`. The API returns the number AS A STRING; parsing it
+             is the only transformation applied to a value anywhere in this module, and a
+             string that is not a number raises rather than being dropped.
+
+`unit`       Verbatim `properties.unit_of_measure` ("ft^3/s", "Acre-ft"). Unlike NOAA --
+             whose response echoes no unit, so the binding has to carry the requested one
+             into the extractor -- USGS states the unit in every item. This extractor
+             therefore takes NO constructor parameters at all: everything it writes, it
+             read. Nothing is defaulted and nothing can drift out of step with the request.
+
+`method`     Verbatim `properties.statistic_id` ("00003" = MEAN). Phase 31 settled this
+             shape: USGS's own data model separates WHICH NUMBER from HOW IT WAS COMPUTED,
+             and the verbatim source token is what goes in `method` -- as `magnitude_type`
+             ("mb", "ml") does for earthquakes. A daily mean, a daily maximum and a daily
+             minimum of the same parameter are three different quantities, and this is the
+             field that says which one a value is. It is not translated into prose here:
+             "00003" is what the source wrote.
+
+`measurement_time`
+             Verbatim `properties.time`: a BARE DATE, "2023-01-07". The API defines it only
+             as the date an observation represents and states NO time zone, so no zone, no
+             instant and no UTC day bounds are assigned here. A consumer that needs an
+             instant must declare which one and cite the assumption; DAF records what the
+             source said.
+
+`monitoring_location_id`, `parameter_code`, `statistic_id`, `time_series_id`
+             Verbatim, so a value can be traced to its series without re-reading the URL.
+
+WHAT IS DELIBERATELY *NOT* IN `content`
+---------------------------------------
+
+`approval_status` ("Approved" / "Provisional") and `qualifier` are REVISION METADATA: they
+say how far a value has moved through USGS's review, not what was measured. NOAA's `q`
+flag is kept out of content for exactly this reason, and so are these. A value that later
+flips from Provisional to Approved WITHOUT changing is the same evidence, and must hash to
+the same id; putting the status in content would make the review step look like a new
+measurement. A value that changes IS new evidence, and its content changes on its own.
+
+`last_modified` is an acquisition/revision stamp of the same kind, and `id` is the API's
+row id, which is regenerated on revision -- neither is a property of the water.
+
+NO `conditions`. The first draft of this extractor built one, a `FrozenMapping` of
+`parameter_code` and `statistic_id`, and DAF's own `test_no_extractor_declares_a_conditions_key`
+refused it -- correctly. Section 20's rule is that an extractor may CARRY conditions and may
+not CONSTRUCT them, and although both values came from the response, the DECISION that those
+two fields are "the conditions" of a daily value came from here. NOAA is the recorded
+exception (Phase 33 found `datum` a genuine measurement condition); the GPC extractor carries
+the source report's own mapping. This source states no measurement conditions at all, so none
+are recorded, and `science.admissibility` reports MISSING_CONDITIONS -- which is true. Nothing
+was lost: `method` already carries the statistic, so a daily mean and a daily maximum are
+distinct in content without a fabricated condition saying so.
+
+NO UNCERTAINTY IS EMITTED. The response states none. There is no `uncertainty`, no
+`uncertainty_kind`, and no `sigma` -- not even a "none stated" marker, because
+`science.admissibility` already reports MISSING_UNCERTAINTY_KIND for exactly this case and
+that report is TRUE. USGS publishes rating-curve accuracy qualitatively, per site and per
+period, in places this endpoint does not carry; turning that into a number here would be
+fabrication. A consumer that needs an R must declare it with its own citation.
+"""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from typing import Any, Dict, List, Mapping, Tuple
+
+from evidence.types import Record
+from scout.interface import ExtractedEntity, ExtractedRelation, ExtractionCandidate
+
+EXTRACTION_METHOD = "json:usgs_daily_value_v1"
+SITE_KIND = "monitoring_location"
+PARAMETER_KIND = "observed_parameter"
+MEASURES = "measures"
+
+# USGS parameter code -> the property name DAF records. Deliberately a small, explicit
+# table: an unlisted code is refused, never given a generated name. Codes and their
+# definitions are USGS's (https://help.waterdata.usgs.gov/codes-and-parameters/parameters).
+PARAMETER_PROPERTIES = {
+    "00060": "discharge",           # Discharge, cubic feet per second
+    "00054": "reservoir_storage",   # Reservoir storage, acre-feet
+    "00065": "gage_height",         # Gage height, feet
+}
+
+
+class UsgsDailyValuesExtractionError(ValueError):
+    """The Record's raw_content is not a parseable USGS daily-values response, a feature is
+    missing a required field, a value is not a parseable number, or the parameter code is
+    not one this extractor has been taught."""
+
+
+@dataclass(frozen=True)
+class UsgsDailyValuesExtractor:
+    """Takes no parameters: every field it writes, it reads from the response. See the
+    module docstring on `unit`."""
+
+    def extract(self, record: Record) -> Tuple[ExtractionCandidate, ...]:
+        try:
+            payload = json.loads(record.raw_content)
+        except json.JSONDecodeError as exc:
+            raise UsgsDailyValuesExtractionError(f"record {record.id!r} is not valid JSON") from exc
+        if not isinstance(payload, dict) or not isinstance(payload.get("features"), list):
+            raise UsgsDailyValuesExtractionError(
+                f"record {record.id!r} has no 'features' array; it is not a USGS daily-values response"
+            )
+
+        candidates: List[ExtractionCandidate] = []
+        for feature in payload["features"]:
+            properties = feature.get("properties") if isinstance(feature, dict) else None
+            if not isinstance(properties, Mapping):
+                raise UsgsDailyValuesExtractionError(
+                    f"record {record.id!r} has a feature with no 'properties' object: {feature!r}"
+                )
+            candidates.append(self._candidate(record, properties))
+        return tuple(candidates)
+
+    def _candidate(self, record: Record, properties: Mapping[str, Any]) -> ExtractionCandidate:
+        missing = [
+            field
+            for field in ("monitoring_location_id", "parameter_code", "statistic_id", "time",
+                          "value", "unit_of_measure")
+            if properties.get(field) in (None, "")
+        ]
+        if missing:
+            raise UsgsDailyValuesExtractionError(
+                f"record {record.id!r} has a daily value missing {missing}: {dict(properties)!r}"
+            )
+
+        parameter_code = str(properties["parameter_code"])
+        try:
+            property_name = PARAMETER_PROPERTIES[parameter_code]
+        except KeyError:
+            raise UsgsDailyValuesExtractionError(
+                f"record {record.id!r} carries USGS parameter code {parameter_code!r}, which this extractor "
+                f"has no property name for; known codes are {sorted(PARAMETER_PROPERTIES)}. Add it "
+                f"deliberately, with the USGS parameter definition, rather than generating a name"
+            ) from None
+
+        raw_value = properties["value"]
+        try:
+            value = float(raw_value)
+        except (TypeError, ValueError) as exc:
+            raise UsgsDailyValuesExtractionError(
+                f"record {record.id!r} has a non-numeric daily value {raw_value!r}"
+            ) from exc
+
+        site = str(properties["monitoring_location_id"])
+        statistic_id = str(properties["statistic_id"])
+        content: Dict[str, Any] = {
+            "property": property_name,
+            "value": value,
+            "unit": str(properties["unit_of_measure"]),
+            "method": statistic_id,
+            "monitoring_location_id": site,
+            "parameter_code": parameter_code,
+            "statistic_id": statistic_id,
+            "measurement_time": str(properties["time"]),
+        }
+        time_series_id = properties.get("time_series_id")
+        if time_series_id not in (None, ""):
+            content["time_series_id"] = str(time_series_id)
+
+        entities = (
+            ExtractedEntity(label=site, kind=SITE_KIND),
+            ExtractedEntity(label=parameter_code, kind=PARAMETER_KIND),
+        )
+        relations = (ExtractedRelation(from_label=site, to_label=parameter_code, type=MEASURES),)
+        return ExtractionCandidate(
+            content=content, entities=entities, relations=relations,
+            extraction_method=EXTRACTION_METHOD, confidence=1.0,
+        )

+"""Real `scout.interface.SourceAdapter` against the USGS Water Data OGC API's
+`daily` collection (https://api.waterdata.usgs.gov/ogcapi/v1/collections/daily).
+
+A FOURTH acquisition topology, and the first that is a *statistic* rather than a
+measurement (see `docs/PHASE_45_USGS_DAILY_VALUES.md` for the full record):
+
+    EDGAR (Phase G)        USGS events (Phase H)    NOAA (Phase I)         USGS daily (Phase 45)
+    --------------------   ---------------------    --------------------   ---------------------
+    unit = one whole       unit = one individual    unit = one bounded     unit = one bounded
+      daily index FILE       event RECORD             TIME WINDOW of         TIME WINDOW of one
+                                                      many readings          SERIES -- each item
+                                                                             has its own id, but
+                                                                             that id is a row id
+                                                                             that CHANGES on
+                                                                             revision
+    locator IS the         locator is NOT the       locator IS the         locator IS the cursor
+      cursor                 cursor                   cursor                 again
+    never revised          records get revised      windows get            values get revised:
+                                                      re-fetched with        Provisional ->
+                                                      different bytes        Approved, and a
+                                                                             value may change
+
+INVESTIGATED, NOT ASSUMED. The live endpoint was read before this module was written:
+
+- Items come back in NO time order. A window's readings must be sorted by the consumer;
+  nothing here reorders the bytes, and the extractor emits candidates in the order the
+  response carries them.
+- `value` is a STRING ("68160"), not a number.
+- Paging is by opaque cursor in `links[rel="next"]`, and `limit` goes up to 10000.
+- `properties.time` is a BARE DATE ("2023-01-07") with NO time zone. The API's own
+  description defines it only as the date an observation represents. This adapter does
+  not assign it a zone, an instant or UTC day bounds: the date is preserved verbatim as
+  the source wrote it, and what a day means is a question for whoever reads it. Legacy
+  NWIS practice is the site's local standard-time day; this API does not say so, and
+  DAF does not put words in a source's mouth.
+- Each item carries `approval_status` ("Approved"/"Provisional") and `qualifier`. These
+  are REVISION metadata, exactly like NOAA's `q` flag, and the extractor keeps them out
+  of `Observation.content` (see the extractor's docstring).
+- Nothing in the response states a per-value uncertainty, so none is emitted and none is
+  invented. A consumer that needs one must declare it, with its own citation.
+
+ONE WINDOW IS ONE ARTIFACT, AND PAGING IS REFUSED, NOT STITCHED. A `RawDocument` here is
+one HTTP response preserved byte-for-byte, as EDGAR/USGS-events/NOAA all are. A daily
+series yields at most 366 items a year, far under the API's 10000 `limit`, so a window
+within `MAX_WINDOW_DAYS` is always a single response. If the API nevertheless returns a
+`next` link, the adapter RAISES: stitching pages into one synthetic document would
+fabricate bytes no server ever sent, and silently dropping the tail would lose data. The
+error names the window and says to shorten it.
+
+Trailing-safety-window catch-up, the same idiom as the NOAA adapter and for the same
+root cause in a different guise: `revision_lookback_days` re-requests the trailing days
+of the previous window, because an already-acquired day can later flip from Provisional
+to Approved (and its value can change with it). A re-fetched window whose bytes are
+unchanged is one artifact version already in the pool, so the plan reports DUPLICATE and
+the catch-up terminates on its own.
+"""
+
+from __future__ import annotations
+
+import datetime
+import json
+import re
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from dataclasses import dataclass, field
+from typing import Any, Callable, Optional, Tuple
+
+from scout.interface import RawDocument
+
+DAILY_ITEMS_BASE = "https://api.waterdata.usgs.gov/ogcapi/v1/collections/daily/items"
+
+# USGS asks every automated client to identify itself -- a public identification
+# string, not a credential. Same policy as `daf.adapters.usgs_earthquakes`.
+USGS_USER_AGENT = "Data-Acquisition-Fabric research-adapter contact@example.com"
+
+_TRANSIENT_HTTP_STATUSES = frozenset({429, 500, 502, 503, 504})
+_MAX_RETRIES = 2
+_RETRY_DELAY_SECONDS = 0.5
+
+# The API's documented maximum page size. Requested explicitly so that a window's
+# single-response property is a consequence of a declared bound, not of a default.
+PAGE_LIMIT = 10000
+# A daily series yields one item per day, so this stays far inside PAGE_LIMIT while
+# bounding how much one artifact can be.
+MAX_WINDOW_DAYS = 366
+_DEFAULT_WINDOW_DAYS = 366
+_DEFAULT_REVISION_LOOKBACK_DAYS = 2
+
+_DATE_RE = re.compile(r"\A\d{4}-\d{2}-\d{2}\Z")
+
+Fetcher = Callable[[str], bytes]
+Opener = Callable[..., Any]
+Sleeper = Callable[[float], None]
+
+
+class UsgsDailyValuesFetchError(RuntimeError):
+    """Any acquisition-time failure: a non-transient HTTP error, a transient one that
+    exhausted its retry budget, a connection failure, an undecodable or unparseable body,
+    a response with no `features` array, or a window the API answered with more than one
+    page."""
+
+
+def _fetch_with_retries(
+    url: str, opener: Opener = urllib.request.urlopen, sleep: Sleeper = time.sleep
+) -> bytes:
+    """Bounded, deterministic retry -- the identical policy to
+    `daf.adapters.usgs_earthquakes._fetch_with_retries` and
+    `daf.adapters.edgar_daily_index._fetch_with_retries`: up to `_MAX_RETRIES` additional
+    attempts, fixed backoff, only for statuses conventionally treated as transient. A
+    non-transient error never retries. `opener`/`sleep` are injectable purely for
+    unit-testability."""
+    request = urllib.request.Request(url, headers={"User-Agent": USGS_USER_AGENT})
+    last_error: BaseException = UsgsDailyValuesFetchError(f"USGS request to {url!r} never attempted")
+
+    for attempt in range(_MAX_RETRIES + 1):
+        try:
+            with opener(request, timeout=60) as response:
+                return response.read()  # type: ignore[no-any-return]
+        except urllib.error.HTTPError as exc:
+            last_error = exc
+            if exc.code not in _TRANSIENT_HTTP_STATUSES or attempt == _MAX_RETRIES:
+                raise UsgsDailyValuesFetchError(f"USGS request to {url!r} failed: HTTP {exc.code}") from exc
+        except (urllib.error.URLError, TimeoutError) as exc:
+            last_error = exc
+            if attempt == _MAX_RETRIES:
+                raise UsgsDailyValuesFetchError(f"USGS request to {url!r} failed: {exc}") from exc
+        if attempt < _MAX_RETRIES:
+            sleep(_RETRY_DELAY_SECONDS)
+
+    raise UsgsDailyValuesFetchError(f"USGS request to {url!r} failed after {_MAX_RETRIES} retries: {last_error}")
+
+
+def _default_fetch(url: str) -> bytes:
+    return _fetch_with_retries(url)
+
+
+def _parse_date(value: str) -> datetime.date:
+    if not _DATE_RE.match(value):
+        raise UsgsDailyValuesFetchError(f"expected a date as YYYY-MM-DD, got {value!r}")
+    return datetime.date.fromisoformat(value)
+
+
+def _format_date(value: datetime.date) -> str:
+    return value.isoformat()
+
+
+def window_end_of(locator: str) -> str:
+    """The cursor value a daily-values window locator carries -- its end date, the LAST
+    component. Adapter-local, exactly like `daf.adapters.noaa_water_level.window_end_of`
+    and EDGAR's own date-string locators; never imported by DAF core."""
+    return locator.rsplit(":", 1)[-1]
+
+
+@dataclass(frozen=True)
+class UsgsDailyValuesSourceAdapter:
+    """One bounded window of ONE daily series: one monitoring location, one parameter
+    code, one statistic."""
+
+    monitoring_location_id: str
+    parameter_code: str
+    statistic_id: str
+    start_date: str  # YYYY-MM-DD, the acquisition scope's lower bound (inclusive)
+    end_date: str  # YYYY-MM-DD, the acquisition scope's upper bound (inclusive)
+    retrieved_at: str  # ISO-8601 UTC, caller-supplied -- never wall-clock
+    since_window_end: Optional[str] = None  # YYYY-MM-DD, opaque to DAF core
+    window_days: int = _DEFAULT_WINDOW_DAYS
+    revision_lookback_days: int = _DEFAULT_REVISION_LOOKBACK_DAYS
+    fetch_bytes: Fetcher = field(default=_default_fetch)
+
+    def __post_init__(self) -> None:
+        if not 1 <= self.window_days <= MAX_WINDOW_DAYS:
+            raise UsgsDailyValuesFetchError(
+                f"window_days must be between 1 and {MAX_WINDOW_DAYS} (a daily series must fit one "
+                f"page of {PAGE_LIMIT}); got {self.window_days}"
+            )
+        if self.revision_lookback_days < 1:
+            raise UsgsDailyValuesFetchError(
+                f"revision_lookback_days must be at least 1; got {self.revision_lookback_days}"
+            )
+
+    def fetch(self) -> Tuple[RawDocument, ...]:
+        scope_end = _parse_date(self.end_date)
+
+        if self.since_window_end is None:
+            window_start = _parse_date(self.start_date)
+        else:
+            previous_end = _parse_date(self.since_window_end)
+            # Trailing safety window: re-verify the last `revision_lookback_days` of the
+            # previous window, because Provisional values can be revised. See the module
+            # docstring.
+            window_start = previous_end - datetime.timedelta(days=self.revision_lookback_days - 1)
+
+        if window_start > scope_end:
+            return ()  # scope fully covered -- nothing left to acquire
+
+        window_end = min(window_start + datetime.timedelta(days=self.window_days - 1), scope_end)
+
+        query = urllib.parse.urlencode(
+            {
+                "monitoring_location_id": self.monitoring_location_id,
+                "parameter_code": self.parameter_code,
+                "statistic_id": self.statistic_id,
+                "datetime": f"{_format_date(window_start)}/{_format_date(window_end)}",
+                "limit": PAGE_LIMIT,
+                "f": "json",
+            }
+        )
+        url = f"{DAILY_ITEMS_BASE}?{query}"
+        raw_bytes = self.fetch_bytes(url)
+        try:
+            content = raw_bytes.decode("utf-8")
+        except UnicodeDecodeError as exc:
+            raise UsgsDailyValuesFetchError(f"USGS response for {url!r} was not valid UTF-8") from exc
+
+        try:
+            payload = json.loads(content)
+        except json.JSONDecodeError as exc:
+            raise UsgsDailyValuesFetchError(f"USGS response for {url!r} was not valid JSON") from exc
+        if not isinstance(payload, dict) or not isinstance(payload.get("features"), list):
+            raise UsgsDailyValuesFetchError(f"USGS response for {url!r} had no 'features' array")
+
+        # Paging is refused, never stitched -- see the module docstring.
+        links = payload.get("links")
+        if isinstance(links, list) and any(
+            isinstance(link, dict) and link.get("rel") == "next" for link in links
+        ):
+            raise UsgsDailyValuesFetchError(
+                f"USGS answered {url!r} with more than one page (a 'next' link is present); one window is "
+                f"one artifact here, so shorten window_days (currently {self.window_days}) until the window "
+                f"fits a single response"
+            )
+
+        locator = (
+            f"{self.monitoring_location_id}:{self.parameter_code}:{self.statistic_id}"
+            f":{_format_date(window_start)}:{_format_date(window_end)}"
+        )
+        return (
+            RawDocument(
+                source_name="USGS Water Data OGC API -- daily values",
+                source_kind="daily-value-window",
+                content=content,
+                locator=locator,
+                retrieval_method="http:usgs_daily_values_v1",
+                retrieved_at=self.retrieved_at,
+            ),
+        )

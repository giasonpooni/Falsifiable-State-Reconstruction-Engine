    "the_river_design_isolates_more_than_the_cooling_loop": true,
    "the_rivers_remaining_confound_is_physical_not_instrumental": true,
    "the_common_flow_drift_is_invisible_without_routing": true,
    "structural_isolability_does_not_move_with_the_prior": true,
